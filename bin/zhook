#!/usr/bin/env python3
"""
zhook — Claude Code PostToolUse hook that runs zsnag (+ zig ast-check) on edited
.zig files and feeds the findings back to Claude, so I react to my own mistakes
without you having to ask. Designed to be fully reversible.

As a hook (default): reads PostToolUse JSON on stdin, emits additionalContext JSON.
Management:
  zhook --status          is it on?
  zhook --disable         turn OFF (no settings change — just a flag file)
  zhook --enable          turn back ON
  zhook --install         add the hook to ~/.claude/settings.json (backs up first)
  zhook --uninstall       remove ONLY our hook entry; leaves other settings intact
"""
import sys, os, json, subprocess

HERE     = os.path.dirname(os.path.abspath(__file__))
ZSNAG    = os.path.join(HERE, "zsnag")
SELF     = os.path.join(HERE, "zhook")
FLAG     = os.path.expanduser("~/.config/zforge/hook.disabled")
SETTINGS = os.environ.get("ZFORGE_SETTINGS", os.path.expanduser("~/.claude/settings.json"))
MARKER   = "zforge-zig-hook"    # identifies our entry for clean uninstall

# ---- management ----------------------------------------------------------
def disable():
    os.makedirs(os.path.dirname(FLAG), exist_ok=True)
    open(FLAG, "w").close()
    print(f"zhook OFF (flag: {FLAG}). The settings entry stays but does nothing.\nRe-enable: zhook --enable")

def enable():
    if os.path.exists(FLAG):
        os.remove(FLAG)
    print("zhook ON.")

def status():
    off = os.path.exists(FLAG)
    installed = MARKER in (open(SETTINGS).read() if os.path.exists(SETTINGS) else "")
    print(f"installed in settings: {installed}")
    print(f"runtime state: {'DISABLED (flag set)' if off else 'enabled'}")

def install():
    settings = json.load(open(SETTINGS)) if os.path.exists(SETTINGS) else {}
    if os.path.exists(SETTINGS):
        json.dump(settings, open(SETTINGS + ".bak", "w"), indent=2)
    ptu = settings.setdefault("hooks", {}).setdefault("PostToolUse", [])
    ptu = [e for e in ptu if MARKER not in json.dumps(e)]   # drop any prior copy
    ptu.append({
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{"type": "command", "command": f"{SELF}  # {MARKER}", "timeout": 30}],
    })
    settings["hooks"]["PostToolUse"] = ptu
    json.dump(settings, open(SETTINGS, "w"), indent=2)
    print(f"Installed into {SETTINGS} (backup: {SETTINGS}.bak).")
    print("Off switch: zhook --disable   |   Full removal: zhook --uninstall")

def uninstall():
    if not os.path.exists(SETTINGS):
        print("no settings file"); return
    settings = json.load(open(SETTINGS))
    ptu = settings.get("hooks", {}).get("PostToolUse", [])
    kept = [e for e in ptu if MARKER not in json.dumps(e)]
    if "hooks" in settings:
        if kept:
            settings["hooks"]["PostToolUse"] = kept
        else:
            settings["hooks"].pop("PostToolUse", None)
        if not settings["hooks"]:
            settings.pop("hooks")
    json.dump(settings, open(SETTINGS, "w"), indent=2)
    print(f"Removed our hook from {SETTINGS}. Other settings untouched.")

# ---- the hook itself -----------------------------------------------------
def run_hook():
    if os.path.exists(FLAG) or os.environ.get("ZFACT_HOOK") == "off":
        return 0                                    # disabled: silent no-op
    try:
        data = json.load(sys.stdin)
    except Exception:
        return 0
    fp = (data.get("tool_input") or {}).get("file_path", "") or ""
    if not fp.endswith(".zig") or not os.path.isfile(fp):
        return 0

    findings = []
    try:
        r = subprocess.run([sys.executable, ZSNAG, fp], capture_output=True, text=True, timeout=20)
        if r.stdout.strip() and "clean" not in r.stdout:
            findings.append(r.stdout.strip())
    except Exception:
        pass
    try:
        r = subprocess.run(["zig", "ast-check", fp], capture_output=True, text=True, timeout=20)
        if r.returncode != 0 and r.stderr.strip():
            findings.append("zig ast-check:\n" + r.stderr.strip())
    except Exception:
        pass

    if not findings:
        return 0
    ctx = (f"zfact/zsnag checked {os.path.basename(fp)} and flagged issues — "
           f"please review and fix:\n\n" + "\n\n".join(findings) +
           "\n\n(Confirm current APIs with `zfact <symbol>` before changing.)")
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PostToolUse", "additionalContext": ctx[:9000]}}))
    return 0

if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    actions = {"--disable": disable, "--enable": enable, "--status": status,
               "--install": install, "--uninstall": uninstall}
    if arg in actions:
        actions[arg]()
    else:
        sys.exit(run_hook())
